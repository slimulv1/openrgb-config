# white — Mainboard trắng + Deepcool LT720 pump xanh dương; RAM trắng mờ 40%.
# GPU (RX 7800 XT) chạy rainbow wave tự do.
# To edit: change COLORS/BRIGHTNESS per section, then run: apply-rgb white
MODE=static
COLORS=FFFFFF
BRIGHTNESS=80

# RAM — 40%
[kingston]
BRIGHTNESS=40

# GPU — rainbow wave tự do (ẩn led không đồng nhất trên card)
[sapphire]
MODE=rainbow wave
BRIGHTNESS=80

# Deepcool LT720 pump on ASUS ARGB Header 1 (zone 1) — resize + xanh dương
# 0040FF: blue thuần, tránh ngả vàng (LED pump kênh blue yếu, white bị ngả ấm)
[asus|1]
MODE=static
COLORS=0040FF
BRIGHTNESS=100
SIZE=22

# ASUS mainboard onboard lighting (zone 0) — white
[asus|0]
MODE=static
COLORS=FFFFFF
BRIGHTNESS=100
