# ASUS AURA LED Controller (0b05:19af) — OpenRGB detects the mainboard RGB
# via this hidraw node. Grant early group access (same pattern as
# 45-i2c-tools.rules GROUP="i2c") so the node is usable before the GUI
# login triggers the uaccess ACL, which previously delayed boot color.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="19af", GROUP="i2c", MODE="0660", TAG+="uaccess"
